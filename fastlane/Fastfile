default_platform(:ios)

# Fastlane 2.238.0 conoce READY_FOR_REVIEW, pero todavía no lo considera
# editable al buscar la versión de App Store Connect.
module ReadyForReviewEditVersion
  def get_edit_app_store_version(client: nil, platform: nil, includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES)
    version = super
    return version if version

    client ||= Spaceship::ConnectAPI
    platform ||= Spaceship::ConnectAPI::Platform::IOS
    filter = {
      appVersionState: Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::READY_FOR_REVIEW,
      platform: platform
    }

    get_app_store_versions(client: client, filter: filter, includes: includes)
      .sort_by { |candidate| Gem::Version.new(candidate.version_string) }
      .last
  end
end

Spaceship::ConnectAPI::App.prepend(ReadyForReviewEditVersion)

platform :ios do
  desc "Crea la versión 1.0.1, selecciona la compilación 10 y la envía a revisión"
  lane :submit_review do
    app_version = ENV.fetch("APP_STORE_VERSION", "1.0.1")
    build_number = ENV.fetch("APP_STORE_BUILD_NUMBER", "10")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER_ID"),
      key_content: ENV.fetch("APPLE_API_PRIVATE_KEY"),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app: 6800699896,
      app_identifier: "com.carlosgarau.lacompra",
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      screenshots_path: ENV.fetch("SCREENSHOTS_PATH"),
      metadata_path: ENV.fetch("EMPTY_METADATA_PATH"),
      app_review_attachment_file: ENV.fetch("REVIEW_VIDEO_PATH"),
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: false,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      release_notes: {
        "es-ES" => "Corrige el zoom tras usar el teclado y mejora la conexión de las listas compartidas. Ahora también puedes editar el nombre, la cantidad y la familia de un producto, y añadir una foto opcional para identificarlo mejor."
      },
      run_precheck_before_submit: false,
      version_check_wait_retry_limit: 10,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )
  end
end
